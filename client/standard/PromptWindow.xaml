<Window x:Class="ToyLims.StandardClient.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" MaxHeight="360" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" FontFamily="Segoe UI, Microsoft YaHei">
  <Border Background="#F8FAFB" BorderBrush="#B8C8D0" BorderThickness="1" CornerRadius="10">
    <Border.Effect>
      <DropShadowEffect Color="#233A4B" BlurRadius="18" ShadowDepth="4" Opacity="0.25"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="58"/></Grid.RowDefinitions>
      <Border Background="#243A50" CornerRadius="9,9,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="18,0,10,0">
          <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button HorizontalAlignment="Right" Width="34" Height="34" Content="×" FontSize="22"
                  Foreground="#DCE7EC" Background="Transparent" BorderThickness="0" Cursor="Hand"
                  Click="Cancel_Click"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="20,20,20,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#169CA4" CornerRadius="3"/>
        <TextBlock Grid.Column="1" x:Name="MessageText" Margin="14,0,2,0" Foreground="#2C4553"
                   FontSize="14" LineHeight="23" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </Grid>
      <Border Grid.Row="2" Background="#EEF3F5" CornerRadius="0,0,9,9" BorderBrush="#D7E0E4" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0">
          <Button x:Name="CancelButton" Content="取消" MinWidth="82" Padding="14,6" Margin="4"
                  Background="White" Foreground="#49606D" BorderBrush="#AFC0C8" Cursor="Hand" Click="Cancel_Click"/>
          <Button x:Name="ConfirmButton" Content="确认" MinWidth="88" Padding="16,6" Margin="4"
                  Background="#168E96" Foreground="White" BorderBrush="#168E96" FontWeight="SemiBold"
                  Cursor="Hand" Click="Confirm_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
