<Window x:Class="ToyLims.StandardClient.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="toy-lims 快速录入" Width="540" Height="590" MinWidth="450" MinHeight="360"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Background="#EEF2F4" FontFamily="Segoe UI, Microsoft YaHei" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <Style x:Key="FloatInput" TargetType="TextBox">
      <Setter Property="Height" Value="28"/><Setter Property="Width" Value="92"/>
      <Setter Property="Padding" Value="5,3"/><Setter Property="HorizontalContentAlignment" Value="Right"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="#8FA9B4"/>
      <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#1599A1"/><Setter Property="Background" Value="#EFFBFB"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="FloatButton" TargetType="Button">
      <Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="45"/></Grid.RowDefinitions>
    <Border Background="#243A50">
      <Grid Margin="13,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="快速录入浮窗" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="SummaryText" Text="0 个样品 · 0 个项目" Foreground="#AFC1CC" FontSize="10"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="刷新" Style="{StaticResource FloatButton}" Click="Refresh_Click"/>
          <Button Content="主窗口" Style="{StaticResource FloatButton}" Click="Main_Click"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Margin="9,8,9,4" Padding="9,6" Background="#E8F3F5" CornerRadius="6">
      <TextBlock Text="输入后自动勾选；Enter 跳到下一项，提交前会再次确认。" Foreground="#4D707D" FontSize="11"/>
    </Border>
    <Grid Grid.Row="2" Margin="9,3,9,6">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Jobs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,7" Background="White" BorderBrush="#D3DEE3" BorderThickness="1" CornerRadius="7" Visibility="{Binding FloatingVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <Grid Margin="9,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding DisplayName}" Foreground="#213746" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding AnalytesDisplay}" Foreground="#15848B" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SampleStatusDisplay}" Foreground="#73858E" FontSize="10" VerticalAlignment="Center"/>
                  </Grid>
                  <Border BorderBrush="#E1E7EA" BorderThickness="0,1,0,0">
                    <ItemsControl ItemsSource="{Binding Tasks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="7,3" Visibility="{Binding FloatingVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Analyte}" FontWeight="Bold" Foreground="#253C49" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,7,0">
                              <TextBlock Text="{Binding PrepName}" Foreground="#687983" FontSize="10" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding ExistingDisplay}" Foreground="#93A0A6" FontSize="9" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBox Grid.Column="3" Text="{Binding DraftValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Style="{StaticResource FloatInput}" PreviewKeyDown="Draft_PreviewKeyDown"/>
                            <TextBlock Grid.Column="4" Text="{Binding InputUnit}" Foreground="#60727C" VerticalAlignment="Center" Margin="5,0,0,0"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="EmptyText" Text="当前没有待测项目" Foreground="#788A93" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <Border Grid.Row="3" Background="#F8FAFB" BorderBrush="#D4DEE3" BorderThickness="0,1,0,0">
      <Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="窗口始终置顶" Foreground="#7A8B94" VerticalAlignment="Center" FontSize="10"/>
        <Button Grid.Column="1" x:Name="SubmitButton" Content="提交  Ctrl+Enter" Background="#168E96" Foreground="White" BorderBrush="#168E96" FontWeight="SemiBold" Style="{StaticResource FloatButton}" Click="Submit_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
