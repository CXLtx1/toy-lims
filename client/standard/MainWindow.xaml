<Window x:Class="ToyLims.StandardClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="toy-lims 标准仪器客户端" Width="1180" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#EEF2F4" FontFamily="Segoe UI, Microsoft YaHei"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <SolidColorBrush x:Key="Ink" Color="#213746" />
    <SolidColorBrush x:Key="Muted" Color="#6F818B" />
    <SolidColorBrush x:Key="Accent" Color="#169CA4" />
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#168E96"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#168E96"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E6F0F4"/><Setter Property="Background" Value="#38576C"/>
      <Setter Property="BorderBrush" Value="#5E7787"/><Setter Property="Padding" Value="12,6"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="Background" Value="#E8F3F5"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style x:Key="TaskInput" TargetType="TextBox">
      <Setter Property="Height" Value="29"/><Setter Property="MinWidth" Value="100"/>
      <Setter Property="BorderBrush" Value="#91AAB6"/><Setter Property="Background" Value="#FCFEFF"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="#169CA4"/><Setter Property="Background" Value="#F0FBFB"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="44"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#243A50">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="9" Background="White" VerticalAlignment="Center">
          <svgc:SvgViewbox Source="/Resources/toy-lims.svg" Margin="3"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
          <TextBlock Text="标准仪器工作台" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="TOY-LIMS · COMPACT RESULT ENTRY" Foreground="#9FB5C7" FontSize="9" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="ShowCompletedCheckBox" Content="显示已有数据" Foreground="#D6E3EA" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ShowCompleted_Changed" Unchecked="ShowCompleted_Changed"/>
          <CheckBox x:Name="AutoRefreshCheckBox" Content="自动刷新" IsChecked="True" Foreground="#D6E3EA" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button x:Name="FloatingButton" Content="打开小浮窗" Style="{StaticResource HeaderButton}" Click="ShowFloating_Click" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="16,14,16,6" Padding="14,11" Background="White" BorderBrush="#D6E0E6" BorderThickness="1" CornerRadius="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="245"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="LIMS" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock Grid.Column="1" x:Name="ServerDisplayText" Foreground="#344F5F" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="绑定仪器" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0"/>
        <TextBlock Grid.Column="3" x:Name="InstrumentDisplayText" Foreground="#344F5F" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="当前用户" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock x:Name="UserText" Text="未登录" Foreground="#9A6236" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="5" x:Name="LoginButton" Content="用户登录" Margin="10,0,2,0" Click="Login_Click"/>
        <Button Grid.Column="6" Content="刷新任务" Style="{StaticResource PrimaryButton}" Click="Refresh_Click"/>
        <TextBlock Grid.Column="7" x:Name="ConnectionText" Text="尚未连接" Foreground="#8B7040" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="16,4,16,6">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border Margin="0,0,7,0" Padding="12,8" Background="#E7F3F4" CornerRadius="7"><StackPanel><TextBlock Text="待测样品" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="SampleCountText" Text="0" Foreground="{StaticResource Ink}" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Grid.Column="1" Margin="0,0,7,0" Padding="12,8" Background="#EEF3F7" CornerRadius="7"><StackPanel><TextBlock Text="待测项目" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="TaskCountText" Text="0" Foreground="{StaticResource Ink}" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Grid.Column="2" Margin="0,0,7,0" Padding="12,8" Background="#FFF5E5" CornerRadius="7"><StackPanel><TextBlock Text="已填草稿" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="DraftCountText" Text="0" Foreground="#896126" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Grid.Column="3" Padding="12,8" Background="White" BorderBrush="#D8E0E4" BorderThickness="1" CornerRadius="7">
        <StackPanel><TextBlock Text="录入提示" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/><TextBlock Text="输入数值后自动勾选；一次确认会以同一事务上传。已有读数保留，可继续添加平行数据。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="3" Margin="16,2,16,8" IsSharedSizeScope="True">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Jobs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Background="White" BorderBrush="#D5E0E5" BorderThickness="1" CornerRadius="8" Visibility="{Binding MainVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Background="#169CA4" CornerRadius="8,0,0,8"/>
                  <StackPanel Grid.Column="1">
                    <Grid Margin="13,9,13,7">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AnalytesDisplay}" Foreground="#16858C" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="开始测量" Margin="0,0,7,0" Padding="10,3" Style="{StaticResource PrimaryButton}" Visibility="{Binding CanStartMeasurement, Converter={StaticResource BoolToVisibility}}" Click="StartSample_Click"/>
                        <Border Style="{StaticResource Pill}" Margin="0,0,7,0"><TextBlock Text="{Binding Category}" Foreground="#526A77" FontSize="10"/></Border>
                        <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding SampleStatusDisplay}" Foreground="#526A77" FontSize="10"/></Border>
                      </StackPanel>
                    </Grid>
                    <Border BorderBrush="#E1E7EA" BorderThickness="0,1,0,0">
                      <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="12,4" Visibility="{Binding MainVisible, Converter={StaticResource BoolToVisibility}}">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/><ColumnDefinition Width="68" SharedSizeGroup="Analyte"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="160" SharedSizeGroup="Existing"/>
                                <ColumnDefinition Width="115" SharedSizeGroup="Input"/><ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="72"/>
                              </Grid.ColumnDefinitions>
                              <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                              <TextBlock Grid.Column="1" Text="{Binding Analyte}" Foreground="{StaticResource Ink}" FontWeight="Bold" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="2" Text="{Binding PrepDisplay}" Foreground="#566A76" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,12,0" ToolTip="{Binding PrepDisplay}"/>
                              <TextBlock Grid.Column="3" Text="{Binding ExistingDisplay}" Foreground="#73848D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExistingDisplay}"/>
                              <TextBox Grid.Column="4" Text="{Binding DraftValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Style="{StaticResource TaskInput}" PreviewKeyDown="Draft_PreviewKeyDown"/>
                              <TextBlock Grid.Column="5" Text="{Binding InputUnit}" Foreground="#61747E" VerticalAlignment="Center" Margin="6,0,0,0"/>
                              <TextBlock Grid.Column="6" Text="{Binding TaskStatusDisplay}" Foreground="#81919A" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="EmptyText" Text="当前仪器没有开放录入的待测项目" Foreground="#7C8D96" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

    <Border Grid.Row="4" Background="#F8FAFB" BorderBrush="#D6DFE4" BorderThickness="0,1,0,0">
      <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="等待连接" Foreground="#637781" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="清空草稿" Click="ClearDrafts_Click"/>
          <Button x:Name="SubmitButton" Content="提交已勾选读数  Ctrl+Enter" Style="{StaticResource PrimaryButton}" Click="Submit_Click" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
