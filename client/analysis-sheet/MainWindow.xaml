<Window x:Class="Oxsas.AnalysisSheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OXSAS 分析单" Width="860" Height="500" MinWidth="760" MinHeight="450"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
  <Grid Background="#F2F4F6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#2C3E50" Padding="15,11">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="只读连接本机 OXSAS · ANALYSES"
                   Foreground="#C7D5DF" VerticalAlignment="Center" />
        <TextBlock Text="OXSAS 分析单" Foreground="White" FontSize="19" FontWeight="SemiBold" />
      </DockPanel>
    </Border>
    <StackPanel Grid.Row="1" Margin="15">
      <Border Background="White" BorderBrush="#CDD3D8" BorderThickness="1" Padding="14" Margin="0,0,0,11">
        <StackPanel>
          <DockPanel Margin="0,0,0,11">
            <Button DockPanel.Dock="Right" Content="刷新数据库" Padding="15,6" Click="RefreshSamples_Click" />
            <StackPanel>
              <TextBlock Text="从 OXSAS 选择分析结果" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="SampleALabel" Text="样品1" FontWeight="Bold" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SampleABox" IsEditable="False"
                      DisplayMemberPath="Label" Padding="5" Margin="0,2,0,5"
                      SelectionChanged="Sample_SelectionChanged" />
            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SampleBLabel" Text="样品2" FontWeight="Bold" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SampleBBox" IsEditable="False"
                      DisplayMemberPath="Label" Padding="5" Margin="0,5,0,2"
                      SelectionChanged="Sample_SelectionChanged" />
          </Grid>
          <TextBlock x:Name="SampleLoadText" Foreground="#61717C" Margin="42,8,0,0" />
        </StackPanel>
      </Border>
      <Border Background="White" BorderBrush="#CDD3D8" BorderThickness="1" Padding="14">
        <StackPanel>
          <TextBlock Text="输出设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="180" />
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="120" />
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="模板" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="1" x:Name="TemplateBox" DisplayMemberPath="Name" SelectionChanged="Template_SelectionChanged" />
            <TextBlock Grid.Column="2" Text="日期" VerticalAlignment="Center" Margin="18,0,6,0" />
            <DatePicker Grid.Column="3" x:Name="DateBox" />
            <TextBlock Grid.Column="4" Text="送样时间" VerticalAlignment="Center" Margin="18,0,6,0" />
            <TextBox Grid.Column="5" x:Name="TimeBox" />
          </Grid>
          <DockPanel Margin="0,9,0,0">
            <Button DockPanel.Dock="Right" Content="浏览…" Padding="13,5" Click="BrowseOutput_Click" />
            <TextBlock Text="输出文件" VerticalAlignment="Center" Margin="0,0,7,0" />
            <TextBox x:Name="OutputPathBox" Padding="5,3" />
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    <Border Grid.Row="2" Background="#E7EBEE" BorderBrush="#C7CDD2" BorderThickness="0,1,0,0" Padding="13,9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="生成 Excel" Padding="18,7" Margin="0,0,8,0" Click="Generate_Click" />
          <Button Content="直接打印" Padding="18,7" FontWeight="SemiBold"
                  Background="#2F98D0" Foreground="White" Click="Print_Click" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Text="准备就绪" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
