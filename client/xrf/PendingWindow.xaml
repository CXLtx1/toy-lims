<Window x:Class="ToyLims.XrfClient.PendingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="toy-lims · XRF 待测" Width="560" Height="430"
        MinWidth="460" MinHeight="280" Topmost="True"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Icon="{svgc:SvgImage Source=/Resources/toy-lims.svg}"
        FontFamily="Microsoft YaHei UI" Background="#F2F5F7">
  <Window.Resources>
    <Style x:Key="SampleNameButton" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#173A57" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="HitArea" Background="Transparent" CornerRadius="4" Padding="2,1">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HitArea" Property="Background" Value="#E8F3FA" />
                <Setter Property="Foreground" Value="#0879B5" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HitArea" Property="Background" Value="#D5EAF6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="74" />
      <RowDefinition Height="*" />
      <RowDefinition Height="42" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#243A50">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="White"
                VerticalAlignment="Center" HorizontalAlignment="Left">
          <svgc:SvgViewbox Source="/Resources/toy-lims.svg" Margin="3" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="XRF 待测样品" Foreground="White" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="TOY-LIMS · INSTRUMENT QUEUE" Foreground="#9FB5C7" FontSize="9" Margin="0,3,0,0" />
        </StackPanel>
        <Border Grid.Column="2" VerticalAlignment="Center" Padding="11,5" CornerRadius="12"
                Background="#183047">
          <TextBlock x:Name="CountText" Foreground="#BCE8F5" FontSize="12" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="14,13,14,11">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="SamplesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,9" Padding="15,12" Background="White" CornerRadius="8"
                      BorderBrush="#D9E2E8" BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect Color="#23384A" BlurRadius="7" ShadowDepth="1" Opacity="0.09" />
                </Border.Effect>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="4" CornerRadius="2" Background="#16A6AD" />
                  <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource SampleNameButton}" Click="CopySampleName_Click"
                            ToolTip="单击复制样品名称">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SampleName}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="  单击复制" Foreground="#8AA0AF" FontSize="10"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding AnalytesDisplay}" Foreground="#6D7F8B" FontSize="11"
                               Margin="2,5,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="2" MinWidth="82" Padding="10,5" CornerRadius="5"
                          Background="#EEF5F8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MethodDisplay}"
                               Foreground="#3E6277" FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center"
                  HorizontalAlignment="Center">
        <Border Width="46" Height="46" CornerRadius="23" Background="#E3EDF2">
          <TextBlock Text="0" Foreground="#7690A0" FontSize="18" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="当前没有待测样品" Foreground="#667B89" Margin="0,10,0,0" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Background="#E8EEF2" BorderBrush="#D4DEE5" BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="#16A6AD" Margin="0,0,7,0" />
          <TextBlock Text="单击样品名称即可复制" Foreground="#617582" FontSize="11" />
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="StatusText" Foreground="#1776A5" FontSize="11"
                   HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
