<Window x:Class="ToyLims.XrfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="toy-lims · XRF 数据中心" Width="1240" Height="790"
        MinWidth="980" MinHeight="620" Topmost="False"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closed="Window_Closed"
        Icon="{svgc:SvgImage Source=/Resources/toy-lims.svg}"
        FontFamily="Microsoft YaHei UI" Background="#F2F5F7">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="13,5" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#29465A" />
      <Setter Property="BorderBrush" Value="#C8D5DD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#64A9C9" />
                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F8FC" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCEEF7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="13,5" />
      <Setter Property="Background" Value="#087FB5" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#087FB5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#0A91C8" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#066F9F" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Padding" Value="13,5" />
      <Setter Property="Background" Value="#304B62" />
      <Setter Property="Foreground" Value="#EAF2F6" />
      <Setter Property="BorderBrush" Value="#557084" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#3B5A72" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#203548" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#C8D5DD" />
      <Setter Property="Background" Value="#FBFCFD" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#C8D5DD" />
      <Setter Property="Background" Value="#FBFCFD" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#627683" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="11,0,5,0" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E5EBEF" />
      <Setter Property="VerticalGridLinesBrush" Value="#EEF2F4" />
      <Setter Property="RowBackground" Value="White" />
      <Setter Property="AlternatingRowBackground" Value="#F8FAFB" />
      <Setter Property="AlternationCount" Value="2" />
      <Setter Property="RowHeight" Value="35" />
      <Setter Property="ColumnHeaderHeight" Value="34" />
      <Setter Property="BorderBrush" Value="#D6E0E6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="ColumnHeaderStyle">
        <Setter.Value>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF0F4" />
            <Setter Property="Foreground" Value="#405B6C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D6E0E6" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="CellStyle">
        <Setter.Value>
          <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#DCEEF7" />
                <Setter Property="Foreground" Value="#173A57" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="42" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#243A50">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9" Background="White"
                VerticalAlignment="Center" HorizontalAlignment="Left">
          <svgc:SvgViewbox Source="/Resources/toy-lims.svg" Margin="3" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
          <TextBlock Text="XRF 数据中心" Foreground="White" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="TOY-LIMS · OXSAS INSTRUMENT BRIDGE" Foreground="#9FB5C7" FontSize="9" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="AutoRefreshCheckBox" Content="自动刷新待测" IsChecked="True"
                    Foreground="#D6E3EA" VerticalAlignment="Center" Margin="0,0,13,0" />
          <Button x:Name="ShowPendingButton" Content="显示待测窗口" IsEnabled="False"
                  Click="ShowPending_Click" Style="{StaticResource HeaderButton}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="16,14,16,6" Padding="15,12" Background="White"
            BorderBrush="#D6E0E6" BorderThickness="1" CornerRadius="8">
      <Border.Effect>
        <DropShadowEffect Color="#23384A" BlurRadius="8" ShadowDepth="1" Opacity="0.07" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="32" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Top">
          <Border Width="4" Height="18" CornerRadius="2" Background="#16A6AD" Margin="0,0,9,0" />
          <TextBlock Text="连接与数据源" Foreground="#29465A" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="  连接地址由配置文件控制，不在界面填写" Foreground="#82939E" FontSize="10" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right"
                Padding="10,3" CornerRadius="10" Background="#EEF5F8" VerticalAlignment="Top">
          <TextBlock x:Name="LoginStateText" Text="尚未连接" Foreground="#7B6A45" FontSize="11" />
        </Border>

        <Button Grid.Row="1" Grid.Column="0" x:Name="ConnectButton" Content="重新连接"
                Click="Connect_Click" Margin="0,3,3,3" />
        <Button Grid.Row="1" Grid.Column="1" Content="立即补传并同步（最多 50 条）" Click="ReadOxsas_Click"
                Style="{StaticResource PrimaryButton}" Margin="12,3,3,3" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="16,7,16,12" Background="White"
            BorderBrush="#D6E0E6" BorderThickness="1" CornerRadius="8">
      <Border.Effect>
        <DropShadowEffect Color="#23384A" BlurRadius="8" ShadowDepth="1" Opacity="0.06" />
      </Border.Effect>
      <Grid Margin="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="38" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="4" Height="18" CornerRadius="2" Background="#087FB5" Margin="0,0,9,0" />
            <TextBlock Text="XRF 扫描自动同步" Foreground="#29465A" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="  自动补传所有普通定量扫描，仅同步人工完成的 UQ 最终组成" Foreground="#82939E" FontSize="10" VerticalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="1" Padding="9,3" CornerRadius="10" Background="#EDF5F9" VerticalAlignment="Center">
            <TextBlock x:Name="ScanCountText" Foreground="#527083" FontSize="11" />
          </Border>
        </Grid>
        <DataGrid Grid.Row="1" x:Name="ScansGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="85" />
            <DataGridTextColumn Header="分析时间" Binding="{Binding AnalyzedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" />
            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" Width="160" />
            <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="120" />
            <DataGridTextColumn Header="关键选项" Binding="{Binding Detail}" Width="180" />
            <DataGridTextColumn Header="最终结果 (%)" Binding="{Binding ResultsText}" Width="*" />
            <DataGridTextColumn Header="同步" Binding="{Binding SyncStatus}" Width="130" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="#E7EDF1" BorderBrush="#D3DDE4" BorderThickness="0,1,0,0">
      <Grid Margin="17,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#16A6AD" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Grid.Column="1" x:Name="StatusText" Text="请先连接 LIMS；连接成功后才显示置顶待测窗口。"
                   Foreground="#526977" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" x:Name="LastRefreshText" Foreground="#748894" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
